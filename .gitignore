# Build output — never commit binaries or generated projects
build/
build_emu/
*.exe
*.obj
*.pdb
*.ilk

# Runtime data written next to the app — session logs, observation
# history, and rig.ini contain the operator's site and schedule
logs/
apex_data/
rig.ini

# IDE / local
.vs/
*.user

# Session output not covered above — produced by running the app,
# large, and can carry observing details.
captures/
sharpness/
raduk_log.txt
raduk_session.log

# MSBuild tracker logs left in the build tree.
*.tlog
*.lastbuildstate

# Local backups (e.g. profiles/saturn.ini.working-2026-10-08).
*.bak
*.working-*

# SQLite transient journals beside the knowledge base. They exist
# only while something has the database open.
data/*.db-shm
data/*.db-wal

# The live window layout, written beside the exe at runtime and keyed
# to the monitors of the machine that wrote it. docs\workspace-5monitor.ini
# is the tracked reference; this one is per-machine state. It was
# committed by accident once, by a `git add -A` during a crash hunt.
workspace.ini
