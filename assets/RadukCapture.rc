// RadukCapture.rc — Win32 resource file
// Application icon and version information.
//
// Icon file is in assets/RadukCapture.ico relative to the project root.
// CMakeLists.txt adds this file via target_sources().

#include <windows.h>

// Application icon — replaces the default 'R' in the title bar and taskbar
#define IDI_RADUK 101
IDI_RADUK ICON "assets\\RadukCapture.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,8,0
PRODUCTVERSION  1,0,8,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Raduk Astrophotography"
            VALUE "FileDescription",  "RadukCapture - Planetary Imaging Capture"
            VALUE "FileVersion",      "1.0.8.0"
            VALUE "InternalName",     "RadukCapture"
            VALUE "LegalCopyright",   "Copyright 2026 Raduk Astrophotography"
            VALUE "OriginalFilename", "RadukCapture.exe"
            VALUE "ProductName",      "RadukCapture"
            VALUE "ProductVersion",   "1.0.8.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
